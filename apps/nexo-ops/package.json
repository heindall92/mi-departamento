{
  "name": "nexo-ops",
  "private": true,
  "version": "1.0.0",
  "description": "NEXO-OPS: mesa interactiva de consultoría en IA agéntica, CX/CRM y licitaciones. Zero-Egress.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --outDir ../../nexo-ops --emptyOutDir",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
